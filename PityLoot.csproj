<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PityLoot</RootNamespace>
    <AssemblyName>PityLoot</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>3.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;types\**;src\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 4.1 renamed the server packages SPTarkov.* -> SPTushonka.*; the namespaces
         inside them are unchanged. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
  </PropertyGroup>

  <Target Name="EnsureSptRoot" BeforeTargets="DeployToSpt" Condition="'$(SkipDeploy)' != 'true'">
    <Warning Condition="!Exists('$(SptRoot)')"
             Text="SptRoot '$(SptRoot)' does not exist - skipping deploy. Pass -p:SptRoot=... or -p:SkipDeploy=true." />
  </Target>

  <!-- Deploy dll + config to the live SPT mods folder. -p:SkipDeploy=true when the
       server is running and holding the file. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true' AND Exists('$(SptRoot)')">
    <PropertyGroup>
      <ModDeployDir>$(SptRoot)\SPT_Runtime\user\mods\PityLoot\</ModDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <ConfigFiles Include="$(MSBuildProjectDirectory)\config\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(ModDeployDir)config" ContinueOnError="WarnAndContinue" />
    <Message Text="Deployed $(TargetFileName) + config to $(ModDeployDir)" Importance="high" />
  </Target>

</Project>
